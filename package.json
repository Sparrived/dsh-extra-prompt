{
  "name": "dsh-extra-prompt",
  "version": "0.2.0",
  "description": "Prompt injection, subagent routing, Skill install, rtk output compaction, MCP servers and a session dashboard for DSH — one switchable plugin row each, configured from a settings page in the Web UI",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.mjs",
    "./prompt-injection": "./src/prompt-injection/index.mjs",
    "./subagent-routing": "./src/subagent-routing/index.mjs",
    "./skill-installer": "./src/skill-installer/index.mjs",
    "./rtk-compact": "./src/rtk-compact/index.mjs",
    "./mcp": "./src/mcp/index.mjs",
    "./session-dashboard": "./src/session-dashboard/index.mjs",
    "./settings-api": "./src/settings-api/index.mjs",
    "./web-search-tavily": "./src/web-search-tavily/index.mjs",
    "./prompt-injection/package.json": "./src/prompt-injection/package.json",
    "./prompt-injection/locale/*.json": "./src/prompt-injection/locale/*.json",
    "./subagent-routing/package.json": "./src/subagent-routing/package.json",
    "./subagent-routing/locale/*.json": "./src/subagent-routing/locale/*.json",
    "./skill-installer/package.json": "./src/skill-installer/package.json",
    "./skill-installer/locale/*.json": "./src/skill-installer/locale/*.json",
    "./rtk-compact/package.json": "./src/rtk-compact/package.json",
    "./rtk-compact/locale/*.json": "./src/rtk-compact/locale/*.json",
    "./mcp/package.json": "./src/mcp/package.json",
    "./mcp/locale/*.json": "./src/mcp/locale/*.json",
    "./settings-api/package.json": "./src/settings-api/package.json",
    "./settings-api/locale/*.json": "./src/settings-api/locale/*.json",
    "./web-search-tavily/package.json": "./src/web-search-tavily/package.json",
    "./web-search-tavily/locale/*.json": "./src/web-search-tavily/locale/*.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "locale/*.json",
    "icon.svg",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin"
  ]
}
